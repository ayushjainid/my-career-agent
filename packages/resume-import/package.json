    "fflate": "^0.8.3",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "4.10.38"
  },
  "devDependencies": {
    "@unified-latex/unified-latex-types": "^1.8.4",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
