{
  "name": "@my-career-agent/resume-import",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "description": "Reads a resume (PDF, Word or LaTeX) into structured, reviewable facts. Runs in the browser; the file never leaves the device.",
