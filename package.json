{
  "name": "my-career-agent",
  "private": true,
  "version": "0.1.0",
  "description": "Tool-neutral job search agent: find, rank, plan and prepare applications.",
  "workspaces": [
    "packages/core",
    "packages/resume-import",
    "apps/api",
    "db"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev": "npm run dev -w apps/api",
    "deploy": "npm run deploy -w apps/api",
    "smoke": "node scripts/smoke.mjs",
    "build:web": "npm run build -w packages/resume-import"
  },
  "engines": {
    "node": ">=20"
  }
}
